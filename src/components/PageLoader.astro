    background: var(--off-white);

    transition:
      opacity 400ms ease,
      visibility 400ms ease;
  }

  .page-loader.is-loaded {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .page-loader__inner {
    width: min(320px, 80vw);
  }

  .page-loader__brand {
    display: block;

    margin-bottom: 1rem;

    font-family: var(--font-grotesk);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .page-loader__track {
    position: relative;

    width: 100%;
    height: 2px;

    overflow: hidden;

    background: rgba(255, 255, 255, 0.15);
  }

  .page-loader__bar {
    width: 40%;
    height: 100%;

    background: var(--tech-red);

    animation: loader-progress 900ms ease-in-out infinite;
  }

  .page-loader__status {
    display: block;

