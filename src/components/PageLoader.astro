<div class="page-loader" id="page-loader">
  <div class="page-loader__inner">
    <!-- <span class="page-loader__brand">ANALOG OBSESSION</span> -->

    <div class="page-loader__track">
      <div class="page-loader__bar"></div>
    </div>

    <span class="page-loader__status" id="loader-status">LOADING DIRECTORY</span>
  </div>
</div>

<script>
  const loader = document.getElementById('page-loader');
  const statusText = document.getElementById('loader-status');

  const phrases = [
    "WARMING UP TUBES...",
    "CALIBRATING VU METERS...",
    "SETTING THRESHOLD...",
    "ADJUSTING COMPRESSION RATIO...",
    "SATURATING TRANSFORMERS..."
  ];

  let phraseIndex = 0;

  // Troca a frase a cada 300ms
  const textInterval = setInterval(() => {
    phraseIndex = (phraseIndex + 1) % phrases.length;
    if (statusText) statusText.innerText = phrases[phraseIndex];
  }, 1000);

  function hideLoader() {
    clearInterval(textInterval); // Para a troca de frases
    
    // Opcional: Dá um feedback visual final antes de sumir
    if (statusText) statusText.innerText = "READY."; 

    // Aguarda um instante só para o usuário ler o "READY", depois some
    window.setTimeout(() => {
      loader?.classList.add('is-loaded');

      window.setTimeout(() => {
        loader?.remove();
      }, 400); // 400ms é o tempo que está no seu CSS (opacity 400ms)
    }, 400);
  }

  // A MÁGICA ACONTECE AQUI:
  // O navegador avisa quando todas as imagens e o layout terminaram de carregar
  window.addEventListener('load', hideLoader);

  // FALLBACK DE SEGURANÇA (Boas práticas):
  // Se alguma imagem do site der erro e travar o carregamento, 
  // nós forçamos o loader a sair depois de 8 segundos para o usuário não ficar preso.
  window.setTimeout(hideLoader, 8000);
</script>

<style>
  .page-loader {
    position: fixed;
    inset: 0;
    z-index: 8;

    display: grid;
    place-items: center;

    background: var(--off-white);

    transition:
      opacity 400ms ease,
      visibility 400ms ease;
  }

  .page-loader.is-loaded {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .page-loader__inner {
    width: min(320px, 80vw);
    display: flex;
    flex-direction: column;
    align-items: center;

  }

  .page-loader__brand {
    display: block;

    margin-bottom: 1rem;

    font-family: var(--font-condensed);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .page-loader__track {
    position: relative;

    width: 100%;
    height: 2px;

    overflow: hidden;

    background: rgba(255, 255, 255, 0.15);
  }

  .page-loader__bar {
    width: 40%;
    height: 100%;

    background: var(--tech-red);

    animation: loader-progress 900ms ease-in-out infinite;
  }

  .page-loader__status {
    display: block;

    margin-top: 0.75rem;

    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;

    color: var(--aluminum);
  }

  @keyframes loader-progress {
    from {
      transform: translateX(-100%);
    }

    to {
      transform: translateX(350%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-loader__bar {
      animation: none;
      width: 100%;
    }
  }
</style>