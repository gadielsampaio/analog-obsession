---
import { Image } from 'astro:assets';
import type { Plugin } from '../data/catalog';

interface Props {
  plugin: Plugin;
  priority?: boolean;
}

const {
  plugin,
  priority = false,
} = Astro.props;
---

<article class="unit-sheet" id={plugin.id}>
  <div class="unit-visual">
    <Image
      src={plugin.image}
      alt={plugin.imageAlt}
      inferSize
      width={800}
      layout="constrained"
      quality={80}
      format="webp"
      priority={priority}
    />
  </div>

  <div class="unit-data">
    <div>
      <div class="unit-meta-top">
        <span>UNIT {plugin.number}</span>
        <span>{plugin.tag}</span>
      </div>

      <h2 class="unit-name">
        {plugin.name}
      </h2>

      <p class="unit-desc">
        {plugin.description}
      </p>

      <div class="specs-table">
        {plugin.specs.map((spec) => (
          <div class="spec-row">
            <span class="spec-label">
              {spec.label}
            </span>

            <span class="spec-value">
              {spec.value}
            </span>
          </div>
        ))}
      </div>
    </div>

    <a
      href={plugin.url}
      class="btn-physical"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span>VIEW UNIT →</span>
      <span class="status" aria-hidden="true"></span>
    </a>
  </div>
</article>