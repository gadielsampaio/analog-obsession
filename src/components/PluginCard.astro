---
import { Image } from 'astro:assets';
import type { Plugin } from '../data/catalog';
import posts from '../data/posts.json'
import { sitePath } from '../data/site';

interface Props {
  plugin: Plugin;
  priority?: boolean;
}

const {
  plugin,
  priority = false,
} = Astro.props;

const hasPluginPage = posts.some(
  (post) =>
  post.title.toLowerCase() === plugin.name.toLowerCase()
);

const prefix = `${plugin.category}-`;

const slug = plugin.id.startsWith(prefix) ? plugin.id.slice(prefix.length) : plugin.id;

// const href = hasPluginPage
//   ? sitePath(`plugins/${slug}.html`)
//   : plugin.url;
const href = plugin.url;
---

<article class="unit-sheet" id={plugin.id}>
  <!-- <div class="unit-visual">
    <Image
  src={plugin.image}
src={plugin.image}
  alt={plugin.imageAlt}
  width={1024}
  height={576}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
/>
  </div> -->
  <div class="unit-visual">
  <div class="image-skeleton"></div>

  <img
    src={plugin.image}
    alt={plugin.imageAlt}
    width="1024"
    height="576"
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    class="plugin-image"
    onload="this.classList.add('loaded'); this.previousElementSibling?.remove()"
    onerror="this.previousElementSibling?.remove()"
  />
</div>

  <div class="unit-data">
    <div>
      <div class="unit-meta-top">
        <span>UNIT {plugin.number}</span>
        <span>{plugin.tag}</span>
      </div>

      <h2 class="unit-name">
        {plugin.name}
      </h2>

      <p class="unit-desc">
        {plugin.description}
      </p>

      <div class="specs-table">
        {plugin.specs.map((spec) => (
          <div class="spec-row">
            <span class="spec-label">
              {spec.label}
            </span>

            <span class="spec-value">
              {spec.value}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- <a
      href={href}
      class="btn-physical"
      target={hasPluginPage ? null : '_blank'}
      rel={hasPluginPage ? null : 'noopener noreferrer'}
    > -->
      <a
  href={href}
  class="btn-physical"
  target="_blank"
  rel="noopener noreferrer"
>
      <span>VIEW UNIT →</span>
      <span class="status" aria-hidden="true"></span>
    </a>
  </div>
</article>